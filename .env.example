# Jenkins connection
JENKINS_URL=http://jenkins.example.com:8080
JENKINS_USER=jenkins-user
# Prefer a Jenkins API token over an account password.
JENKINS_API_TOKEN=replace-me

# Remote build token for the job (the ?token= query param).
# The registry can point at a different env var via "build_token_env".
JENKINS_BUILD_TOKEN=your-build-token

# Path to the action registry (job + supported actions).
JENKINS_ACTIONS_CONFIG=./actions.json

# Behaviour
JENKINS_VERIFY_SSL=true
JENKINS_TIMEOUT_SECONDS=600
JENKINS_POLL_INTERVAL=2
JENKINS_POLL_MAX_INTERVAL=10
# 0 (default) returns the full console; set a positive number to tail it
JENKINS_CONSOLE_TAIL_LINES=0

# Set to "false" to bypass the proxy env vars (mirrors session.trust_env = False)
JENKINS_TRUST_ENV=false


########################################################################
# ITSM (itsm-mcp) — only needed if you run the ITSM server
########################################################################
ITSM_URL=https://itsm.example.com
# ServiceDesk Plus technician authtoken. Scope it to a technician that may
# only reassign groups and add notes.
ITSM_AUTHTOKEN=replace-me

# Portal identifier; "1" on a single-portal instance.
ITSM_PORTAL_ID=1

# Path to the write policy (allowed groups + note defaults).
ITSM_CONFIG=./itsm.json

# Behaviour. An instance reached by IP usually presents a cert that fails
# hostname verification — prefer pointing SSL_CERT_FILE at your internal CA
# over turning this off.
ITSM_VERIFY_SSL=true
ITSM_TIMEOUT_SECONDS=30
ITSM_TRUST_ENV=false
